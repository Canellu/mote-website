{
  "name": "mote-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "test:watch": "vp test",
    "build": "vp check && vp test run && bun scripts/generate-sitemap.ts && bun scripts/encode-product-images.ts && vp build && node scripts/verify-static-output.mjs",
    "preview": "vp preview",
    "prepare": "vp config"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.2.9",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  },
